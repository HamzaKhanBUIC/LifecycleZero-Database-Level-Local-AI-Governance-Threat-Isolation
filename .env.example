# Copy to .env.local and fill in. Never commit real values.
# Variables marked "required" make the related endpoint fail closed (HTTP 500) when unset.

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# "true" disables Clerk (local development only; only sandbox tenants are reachable)
NEXT_PUBLIC_SKIP_CLERK=

# --- Webhooks (required for /api/webhooks/*) ---
# Stripe Dashboard -> Developers -> Webhooks -> signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Clerk Dashboard -> Webhooks -> signing secret (whsec_...); CLERK_WEBHOOK_SIGNING_SECRET is accepted as an alias
CLERK_WEBHOOK_SECRET=

# --- Endpoint agent / ingest (required for /api/ingest) ---
# Global enrollment key shared with agents; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=
# Admin token for POST /api/webhooks/rotate-key (required for that route)
ADMIN_ROTATION_SECRET=
# Local agent only (scripts/lifecycle-agent.ts)
INGEST_URL=
TENANT_ID=

# --- AWS ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ARN=
DYNAMODB_TABLE=
SQS_QUEUE_URL=
# "true" uses DynamoDB Local on http://localhost:8000
DB_LOCAL=

# --- Local AI evaluation (Ollama) ---
OLLAMA_HOST=
OLLAMA_MODEL=
# Comma-separated hosts (or host:port) the server may call for tenant Ollama endpoints.
# Default: localhost,127.0.0.1. The host of OLLAMA_HOST is always allowed.
OLLAMA_ALLOWED_HOSTS=
# Corporate TLS-intercepting proxy: path to its CA bundle (TLS verification is never disabled)
NODE_EXTRA_CA_CERTS=

# --- Rate limiting (optional; in-memory fallback when unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Key rotation production path (referenced in rotate-key comments only) ---
VERCEL_TOKEN=
